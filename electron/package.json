{
  "name": "further-api-electron",
  "version": "1.0.0",
  "description": "further-api desktop gateway",
  "main": "main.js",
  "scripts": {
    "start-app": "electron .",
    "dev-app": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "ai",
    "api",
    "gateway",
    "openai",
    "claude"
  ],
  "author": "further-api contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/dqt081228OHVGFY/further-api"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.furtherapi.desktop",
    "productName": "further-api",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "navigation-policy.cjs",
      "preload.js",
      "icon.png",
      "tray-iconTemplate.png",
      "tray-iconTemplate@2x.png",
      "tray-icon-windows.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../further-api",
          "to": "bin/further-api"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/LICENSE"
        },
        {
          "from": "../NOTICE",
          "to": "licenses/NOTICE"
        },
        {
          "from": "../THIRD-PARTY-LICENSES.md",
          "to": "licenses/THIRD-PARTY-LICENSES.md"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "licenses/electron/LICENSE"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "licenses/electron/LICENSES.chromium.html"
        }
      ]
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "../further-api.exe",
          "to": "bin/further-api.exe"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/LICENSE"
        },
        {
          "from": "../NOTICE",
          "to": "licenses/NOTICE"
        },
        {
          "from": "../THIRD-PARTY-LICENSES.md",
          "to": "licenses/THIRD-PARTY-LICENSES.md"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "licenses/electron/LICENSE"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "licenses/electron/LICENSES.chromium.html"
        }
      ]
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "extraResources": [
        {
          "from": "../further-api",
          "to": "bin/further-api"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/LICENSE"
        },
        {
          "from": "../NOTICE",
          "to": "licenses/NOTICE"
        },
        {
          "from": "../THIRD-PARTY-LICENSES.md",
          "to": "licenses/THIRD-PARTY-LICENSES.md"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "licenses/electron/LICENSE"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "licenses/electron/LICENSES.chromium.html"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "brace-expansion": "2.1.7",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "undici": "7.29.1",
    "http-cache-semantics": "4.3.0",
    "@xmldom/xmldom": "0.8.15"
  }
}
