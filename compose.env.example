# Copy to .env. Compose refuses to start while these values are empty.
# Use URL-safe random characters for PostgreSQL and Redis passwords because
# Compose also places them in connection URLs.
POSTGRES_PASSWORD=
# Existing database volumes can override these defaults during migration.
# POSTGRES_USER=further_api
# POSTGRES_DB=further_api
REDIS_PASSWORD=
SESSION_SECRET=
CRYPTO_SECRET=

# The gateway listens on loopback by default. Put an HTTPS reverse proxy in
# front for public access; explicitly change this only for a managed network.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=3000

# Local HTTP default. For HTTPS, set true and list exact HTTPS origins.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
TRUSTED_PROXIES=none
