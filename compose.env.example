# Copy to .env. Compose refuses to start while these values are empty.
# Use URL-safe random characters for PostgreSQL and Redis passwords because
# Compose also places them in connection URLs.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=

# Local HTTP default. For HTTPS, set true and list exact HTTPS origins.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
TRUSTED_PROXIES=none
